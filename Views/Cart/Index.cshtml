@model List<EcommerceApp.Models.CartItem>
@{
    ViewData["Title"] = "Shopping Cart";
    var subtotal = (decimal)(ViewBag.Subtotal ?? 0m);
    var shipping = subtotal >= 100 ? 0m : 10m;
    var tax = Math.Round(subtotal * 0.05m, 2);
    var total = subtotal + shipping + tax;
}

<div class="container-xxl py-4">
    <div class="d-flex align-items-center gap-2 mb-3">
        <h4 class="fw-bold mb-0"><i class="bi bi-cart3 me-2"></i>Shopping Cart</h4>
        <span class="badge bg-primary rounded-pill">@Model.Sum(x => x.Quantity) items</span>
    </div>

    @if (!Model.Any()) {
        <div class="text-center py-5">
            <i class="bi bi-cart-x" style="font-size:72px;color:#ddd"></i>
            <h5 class="mt-3 text-muted">Your cart is empty</h5>
            <p class="text-muted" style="font-size:13px">Add some products to get started!</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary px-4 mt-1">
                <i class="bi bi-grid me-2"></i>Browse Products
            </a>
        </div>
    } else {
        <div class="row g-4">
            <!-- CART ITEMS -->
            <div class="col-lg-8">
                <div class="bg-white border rounded-3 overflow-hidden mb-3">
                    <table class="table cart-table mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="d-none d-md-table-cell">Price</th>
                                <th>Qty</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model) {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@(item.ImageUrl ?? "/images/misc/no-image.svg")"
                                                 class="cart-img"
                                                 alt="@item.ProductName"
                                                 onerror="this.src='/images/misc/no-image.svg'" />
                                            <div>
                                                <div class="fw-medium" style="font-size:14px;line-height:1.4">@item.ProductName</div>
                                                <div class="text-muted" style="font-size:12px">Unit: $@item.Price</div>
                                                <div class="d-flex gap-2 mt-1">
                                                    <form asp-action="Remove" asp-route-productId="@item.ProductId" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" style="background:none;border:none;color:#dc3545;font-size:12px;padding:0;cursor:pointer">
                                                            <i class="bi bi-trash me-1"></i>Remove
                                                        </button>
                                                    </form>
                                                    <span class="text-muted">|</span>
                                                    <a href="#" style="font-size:12px;color:#0d6efd"><i class="bi bi-heart me-1"></i>Save for later</a>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="d-none d-md-table-cell fw-semibold">$@item.Price</td>
                                    <td>
                                        <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" name="quantity" value="@(item.Quantity-1)"
                                                    class="btn btn-sm btn-outline-secondary" style="width:28px;height:28px;padding:0;line-height:1">−</button>
                                            <span class="fw-bold px-2" style="min-width:24px;text-align:center">@item.Quantity</span>
                                            <button type="submit" name="quantity" value="@(item.Quantity+1)"
                                                    class="btn btn-sm btn-outline-secondary" style="width:28px;height:28px;padding:0;line-height:1">+</button>
                                        </form>
                                    </td>
                                    <td class="fw-bold text-primary">$@item.Total</td>
                                    <td>
                                        <form asp-action="Remove" asp-route-productId="@item.ProductId" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-link text-danger p-0">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left me-1"></i>Continue Shopping
                    </a>
                    <form asp-action="Clear" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Clear all items?')">
                            <i class="bi bi-trash me-1"></i>Clear Cart
                        </button>
                    </form>
                </div>

                <!-- Feature badges -->
                <div class="row g-2">
                    <div class="col-4">
                        <div class="border rounded-3 p-3 text-center bg-white">
                            <i class="bi bi-shield-lock text-primary d-block" style="font-size:22px"></i>
                            <div class="fw-semibold mt-1" style="font-size:12px">Secure Payment</div>
                            <div class="text-muted" style="font-size:11px">SSL encrypted</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded-3 p-3 text-center bg-white">
                            <i class="bi bi-headset text-success d-block" style="font-size:22px"></i>
                            <div class="fw-semibold mt-1" style="font-size:12px">24/7 Support</div>
                            <div class="text-muted" style="font-size:11px">Always available</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="border rounded-3 p-3 text-center bg-white">
                            <i class="bi bi-truck text-warning d-block" style="font-size:22px"></i>
                            <div class="fw-semibold mt-1" style="font-size:12px">Free Delivery</div>
                            <div class="text-muted" style="font-size:11px">Orders over $100</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ORDER SUMMARY -->
            <div class="col-lg-4">
                <div class="summary-box">
                    <h5 class="fw-bold pb-3 border-bottom mb-3">
                        <i class="bi bi-receipt me-2"></i>Order Summary
                    </h5>

                    <!-- Coupon -->
                    <div class="input-group mb-3">
                        <input type="text" class="form-control form-control-sm" placeholder="Coupon code" />
                        <button class="btn btn-outline-secondary btn-sm">Apply</button>
                    </div>

                    <div class="summary-row">
                        <span class="text-muted">Subtotal (@Model.Count items):</span>
                        <span class="fw-medium">$@subtotal</span>
                    </div>
                    <div class="summary-row">
                        <span class="text-muted">Shipping:</span>
                        <span class="@(shipping == 0 ? "text-success fw-medium" : "")">
                            @(shipping == 0 ? "FREE" : "$" + shipping)
                        </span>
                    </div>
                    <div class="summary-row">
                        <span class="text-muted">Tax (5%):</span>
                        <span>$@tax</span>
                    </div>
                    @if (subtotal < 100) {
                        <div class="alert alert-info py-1 px-2 mb-2" style="font-size:11px">
                            <i class="bi bi-truck me-1"></i>Add $@(100 - subtotal) more for FREE shipping!
                        </div>
                    }
                    <div class="summary-row total">
                        <span>Total:</span>
                        <span class="text-primary fs-5">$@total</span>
                    </div>

                    @if (User.Identity!.IsAuthenticated) {
                        <a asp-controller="Order" asp-action="Checkout" class="btn-checkout d-block text-decoration-none">
                            <i class="bi bi-bag-check me-2"></i>Proceed to Checkout
                        </a>
                    } else {
                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Order/Checkout" class="btn-checkout d-block text-decoration-none" style="background:#ff8f00">
                            <i class="bi bi-lock me-2"></i>Login to Checkout
                        </a>
                    }

                    <div class="text-center mt-3">
                        <div style="font-size:11px;color:#777"><i class="bi bi-shield-lock text-success me-1"></i>SSL Secured Checkout</div>
                        <div class="d-flex justify-content-center gap-1 mt-2">
                            <span class="badge bg-primary">VISA</span>
                            <span class="badge bg-danger">MC</span>
                            <span class="badge bg-info">PayPal</span>
                            <span class="badge bg-success">COD</span>
                        </div>
                    </div>
                </div>

                <!-- Saved for later -->
                <div class="bg-white border rounded-3 p-3 mt-3">
                    <div class="fw-bold mb-2" style="font-size:14px">
                        <i class="bi bi-heart me-1 text-danger"></i>Saved for Later
                    </div>
                    @foreach (var item in Model.Take(3)) {
                        <div class="d-flex align-items-center gap-2 py-2 border-bottom">
                            <img src="@(item.ImageUrl ?? "/images/misc/no-image.svg")"
                                 style="width:48px;height:48px;object-fit:cover;border-radius:6px"
                                 onerror="this.src='/images/misc/no-image.svg'" />
                            <div style="flex:1;min-width:0">
                                <div style="font-size:12px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@item.ProductName</div>
                                <div class="fw-bold text-primary" style="font-size:13px">$@item.Price</div>
                            </div>
                            <div class="d-flex flex-column gap-1">
                                <a href="#" style="font-size:11px;color:#0d6efd">Move to cart</a>
                                <a href="#" style="font-size:11px;color:#dc3545">Remove</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
