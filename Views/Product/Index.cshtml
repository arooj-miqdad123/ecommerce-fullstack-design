@model EcommerceApp.ViewModels.ProductListViewModel
@{ ViewData["Title"] = "Products"; }

<div class="container-xxl py-3">
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
      <li class="breadcrumb-item active">Products</li>
      @if(Model.CategoryId.HasValue) {
        var cat=Model.Categories.FirstOrDefault(c=>c.Id==Model.CategoryId);
        if(cat!=null){<li class="breadcrumb-item active">@cat.Name</li>}
      }
    </ol>
  </nav>

  <div class="row g-3">
    <!-- SIDEBAR FILTER -->
    <div class="col-lg-2 col-md-3">
      <form asp-action="Index" method="get" id="filter-form">
        <input type="hidden" name="search" value="@Model.SearchTerm" />
        <input type="hidden" name="viewMode" value="@Model.ViewMode" />
        <div class="filter-box">
          <div class="filter-title">Category</div>
          <div class="filter-group">
            <div class="form-check">
              <input class="form-check-input" type="radio" name="categoryId" value="" id="c-all" @(Model.CategoryId==null?"checked":"") onchange="this.form.submit()" />
              <label class="form-check-label" for="c-all">All Products</label>
            </div>
            @foreach (var cat in Model.Categories) {
              <div class="form-check">
                <input class="form-check-input" type="radio" name="categoryId" value="@cat.Id" id="c-@cat.Id" @(Model.CategoryId==cat.Id?"checked":"") onchange="this.form.submit()" />
                <label class="form-check-label" for="c-@cat.Id">@cat.Name</label>
              </div>
            }
          </div>

          <div class="filter-title">Price Range</div>
          <div class="filter-group">
            <div class="d-flex gap-1 mb-2">
              <input type="number" name="minPrice" value="@Model.MinPrice" placeholder="Min $" class="form-control form-control-sm" />
              <input type="number" name="maxPrice" value="@Model.MaxPrice" placeholder="Max $" class="form-control form-control-sm" />
            </div>
            <button type="submit" class="btn btn-sm btn-primary w-100">Apply</button>
          </div>

          <div class="filter-title">Rating</div>
          <div class="filter-group">
            @for (int r=5;r>=1;r--) {
              <div class="form-check">
                <input class="form-check-input" type="radio" name="minRating" value="@r" id="r-@r" />
                <label class="form-check-label" for="r-@r" style="color:#f39c12;font-size:12px">
                  @for(int s=1;s<=r;s++){<i class="bi bi-star-fill"></i>}
                  <span style="color:#777"> & up</span>
                </label>
              </div>
            }
          </div>
          <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100">Clear All</a>
        </div>
      </form>
    </div>

    <!-- PRODUCTS AREA -->
    <div class="col-lg-10 col-md-9">
      <!-- Top Controls -->
      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div style="font-size:13px;color:#777">
          <strong>@Model.TotalCount</strong> results found
          @if (!string.IsNullOrEmpty(Model.SearchTerm)) { <span>for "<strong>@Model.SearchTerm</strong>"</span> }
        </div>
        <div class="d-flex align-items-center gap-2">
          <select class="form-select form-select-sm" style="width:165px" onchange="window.location=this.value">
                        <option value="@Url.Action("Index", new { search = Model.SearchTerm, categoryId = Model.CategoryId })" selected="@(Model.SortBy == null ? "selected" : null)">Sort: Featured</option>
                        <option value="@Url.Action("Index", new { search = Model.SearchTerm, categoryId = Model.CategoryId, sortBy = "newest" })" selected="@(Model.SortBy == "newest" ? "selected" : null)">Newest first</option>
                        <option value="@Url.Action("Index", new { search = Model.SearchTerm, categoryId = Model.CategoryId, sortBy = "price_asc" })" selected="@(Model.SortBy == "price_asc" ? "selected" : null)">Price: Low to High</option>
                        <option value="@Url.Action("Index", new { search = Model.SearchTerm, categoryId = Model.CategoryId, sortBy = "price_desc" })" selected="@(Model.SortBy == "price_desc" ? "selected" : null)">Price: High to Low</option>
                        <option value="@Url.Action("Index", new { search = Model.SearchTerm, categoryId = Model.CategoryId, sortBy = "rating" })" selected="@(Model.SortBy == "rating" ? "selected" : null)">Top Rated</option>
            </select>
          <div class="btn-group">
            <a asp-action="Index" asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-sortBy="@Model.SortBy" asp-route-viewMode="grid"
               class="btn btn-sm @(Model.ViewMode=="grid"?"btn-primary":"btn-outline-secondary")"><i class="bi bi-grid-3x3-gap"></i></a>
            <a asp-action="Index" asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-sortBy="@Model.SortBy" asp-route-viewMode="list"
               class="btn btn-sm @(Model.ViewMode=="list"?"btn-primary":"btn-outline-secondary")"><i class="bi bi-list-ul"></i></a>
          </div>
        </div>
      </div>

      @if (!Model.Products.Any()) {
        <div class="text-center py-5">
          <i class="bi bi-search" style="font-size:52px;color:#ccc"></i>
          <h5 class="mt-3 text-muted">No products found</h5>
          <a asp-action="Index" class="btn btn-primary mt-2">Browse All</a>
        </div>
      }
      else if (Model.ViewMode == "list") {
        @foreach (var p in Model.Products) {
          <div class="list-item">
            <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id">
              <img src="@(p.ImageUrl??"/images/misc/no-image.svg")" class="list-item-img" alt="@p.Name" onerror="this.src='/images/misc/no-image.svg'" />
            </a>
            <div class="list-item-info">
              <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id" style="color:inherit">
                <div style="font-size:15px;font-weight:600;margin-bottom:4px">@p.Name</div>
              </a>
              <div class="star-row mb-1">
                @for(int s=1;s<=5;s++){<i class="bi bi-star@(s<=p.Rating?"-fill":"")"></i>}
                <span>(@p.ReviewCount orders)</span>
              </div>
              <div style="font-size:13px;color:#777;margin-bottom:8px">@p.ShortDescription</div>
              @if(p.Stock>0){<div class="badge-free"><i class="bi bi-truck me-1"></i>Free Shipping</div>}
            </div>
            <div class="list-item-price-col">
              <div class="price-now" style="font-size:22px">$@p.Price</div>
              @if(p.OldPrice.HasValue){<div class="price-old">$@p.OldPrice</div>}
              <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@p.Id" />
                <button type="submit" class="btn btn-primary btn-sm w-100"><i class="bi bi-cart-plus me-1"></i>Add to Cart</button>
              </form>
              <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm w-100 mt-1">View Details</a>
            </div>
          </div>
        }
      }
      else {
        <div class="row g-3">
          @foreach (var p in Model.Products) {
            <div class="col-6 col-sm-4 col-lg-3">
              <div class="prod-card">
                <div class="prod-img-wrap">
                  <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id">
                    <img src="@(p.ImageUrl??"/images/misc/no-image.svg")" alt="@p.Name" onerror="this.src='/images/misc/no-image.svg'" />
                  </a>
                  @if(p.OldPrice.HasValue){<span class="disc-badge">-@(Math.Round((1-p.Price/p.OldPrice.Value)*100))%</span>}
                </div>
                <div class="prod-body">
                  <a asp-controller="Product" asp-action="Detail" asp-route-id="@p.Id" style="color:inherit">
                    <div class="prod-name">@p.Name</div>
                  </a>
                  <div class="star-row">
                    @for(int s=1;s<=5;s++){<i class="bi bi-star@(s<=p.Rating?"-fill":"")"></i>}
                    <span>(@p.ReviewCount)</span>
                  </div>
                  <div class="price-row">
                    <span class="price-now">$@p.Price</span>
                    @if(p.OldPrice.HasValue){<span class="price-old">$@p.OldPrice</span>}
                  </div>
                  <form asp-controller="Cart" asp-action="AddToCart" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@p.Id" />
                    <button type="submit" class="btn-addcart @(!User.Identity!.IsAuthenticated ? "login-req" : "")">
                      <i class="bi bi-cart-plus me-1"></i>@(!User.Identity!.IsAuthenticated ? "Login to Buy" : "Add to Cart")
                    </button>
                  </form>
                </div>
              </div>
            </div>
          }
        </div>
      }

      @if (Model.TotalPages > 1) {
        <nav class="mt-4">
          <ul class="pagination justify-content-center">
            @for(int pg=1;pg<=Model.TotalPages;pg++){
              <li class="page-item @(pg==Model.CurrentPage?"active":"")">
                <a class="page-link" asp-action="Index" asp-route-search="@Model.SearchTerm" asp-route-categoryId="@Model.CategoryId" asp-route-sortBy="@Model.SortBy" asp-route-viewMode="@Model.ViewMode" asp-route-page="@pg">@pg</a>
              </li>
            }
          </ul>
        </nav>
      }
    </div>
  </div>
</div>
