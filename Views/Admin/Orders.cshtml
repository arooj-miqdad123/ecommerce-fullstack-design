@{ ViewData["Title"] = "Orders"; Layout = "_AdminLayout";
   var orders = ViewBag.Orders as List<EcommerceApp.Models.Order> ?? new(); }

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0">Orders <span class="badge bg-secondary ms-2">@orders.Count</span></h4>
</div>

<div class="d-flex gap-2 mb-3 flex-wrap">
    @foreach (var s in new[] { "", "Pending", "Processing", "Shipped", "Delivered", "Cancelled" }) {
        <a asp-action="Orders" asp-route-status="@s"
           class="btn btn-sm @(ViewContext.HttpContext.Request.Query["status"].ToString()==s?"btn-primary":"btn-outline-secondary")">
            @(string.IsNullOrEmpty(s) ? "All" : s)
        </a>
    }
</div>

<div class="bg-white rounded-3 shadow-sm overflow-hidden">
    <table class="table table-hover mb-0" style="font-size:13px">
        <thead class="table-light">
            <tr><th>Order</th><th>Customer</th><th>Items</th><th>Total</th><th>Payment</th><th>Status</th><th>Date</th><th>Address</th></tr>
        </thead>
        <tbody>
            @foreach (var o in orders) {
                <tr>
                    <td><strong class="text-primary">#ORD-@o.Id.ToString("D5")</strong></td>
                    <td>
                        <div class="fw-medium">@o.CustomerName</div>
                        <div class="text-muted" style="font-size:11px">@o.CustomerEmail</div>
                        <div class="text-muted" style="font-size:11px">@o.CustomerPhone</div>
                    </td>
                    <td><span class="badge bg-secondary">@o.OrderItems.Count</span></td>
                    <td><strong>$@o.Total</strong></td>
                    <td>
                        <span class="badge @(o.PaymentMethod=="Card"?"bg-primary":"bg-success")">@o.PaymentMethod</span><br/>
                        <span class="badge @(o.PaymentStatus=="Paid"?"bg-success":"bg-warning text-dark")" style="font-size:10px">@o.PaymentStatus</span>
                    </td>
                    <td>
                        <form asp-action="UpdateOrderStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="orderId" value="@o.Id" />
                            <select name="status" class="form-select form-select-sm" style="width:120px" onchange="this.form.submit()">
                                @foreach (var s in new[]{"Pending","Processing","Shipped","Delivered","Cancelled"}) {
                                    <option value="@s" selected="@(o.Status == s ? "selected" : null)">@s</option>
                                }
                            </select>
                        </form>
                    </td>
                    <td style="font-size:12px">@o.OrderDate.ToString("dd MMM yyyy")</td>
                    <td style="font-size:11px;color:#777;max-width:120px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                        @o.ShippingAddress, @o.City
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
