@model List<EcommerceApp.Models.Order>
@{ ViewData["Title"] = "My Orders"; }

<div class="container-xxl py-4">
    <h4 class="fw-bold mb-4"><i class="bi bi-bag-check me-2"></i>My Orders</h4>

    @if (!Model.Any()) {
        <div class="text-center py-5">
            <i class="bi bi-bag-x" style="font-size:64px;color:#ddd"></i>
            <h5 class="mt-3 text-muted">No orders yet</h5>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary mt-2 px-4">Start Shopping</a>
        </div>
    } else {
        <div class="bg-white border rounded-3 overflow-hidden">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order ID</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model) {
                        <tr>
                            <td><strong class="text-primary">#ORD-@o.Id.ToString("D5")</strong></td>
                            <td style="font-size:13px">@o.OrderDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge bg-secondary">@o.OrderItems.Count item(s)</span></td>
                            <td><strong>$@o.Total</strong></td>
                            <td>
                                <span class="badge @(o.PaymentMethod=="Card"?"bg-primary":"bg-success")">@o.PaymentMethod</span>
                                <br/><span style="font-size:10px" class="badge @(o.PaymentStatus=="Paid"?"bg-success":"bg-warning text-dark")">@o.PaymentStatus</span>
                            </td>
                            <td>
                                <span class="badge @(o.Status switch {"Delivered"=>"bg-success","Processing"=>"bg-info","Shipped"=>"bg-primary","Cancelled"=>"bg-danger",_=>"bg-warning text-dark"})">
                                    @o.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
