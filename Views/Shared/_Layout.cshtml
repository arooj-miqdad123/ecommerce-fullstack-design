<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Brand Store</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<!-- TOP BAR -->
<div class="topbar d-none d-md-block">
    <div class="container-xxl">
        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex">
                <a href="#"><i class="bi bi-telephone-fill me-1"></i> +92-300-0000000</a>
                <a href="#"><i class="bi bi-headset me-1"></i> Contact us</a>
                <a href="#">About</a>
            </div>
            <div class="d-flex align-items-center">
                @if (User.Identity!.IsAuthenticated)
                {
                    <span style="padding:0 8px;font-size:12px;color:#666"><i class="bi bi-person-check"></i> @User.Identity.Name</span>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index"><i class="bi bi-grid-1x2 me-1"></i>Admin</a>
                    }
                    <a asp-controller="Order" asp-action="MyOrders"><i class="bi bi-bag me-1"></i>My Orders</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="topbar-btn"><i class="bi bi-box-arrow-right me-1"></i>Logout</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login"><i class="bi bi-person me-1"></i>Sign in</a>
                    <a asp-controller="Account" asp-action="Register"><i class="bi bi-person-plus me-1"></i>Register</a>
                }
                <div class="dropdown d-inline-block">
                    <a href="#" class="dropdown-toggle" data-bs-toggle="dropdown" style="text-decoration:none;color:inherit;font-size:12px" id="langDropdown">
                        <img id="selected-flag" src="/images/misc/flag-us.png" style="height:14px;margin-right:4px;vertical-align:middle" onerror="this.style.display='none'" />
                        <span id="selected-lang">English | USD</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" style="min-width:160px;font-size:13px">
                        <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-us.png" data-label="English | USD"><img src="/images/misc/flag-us.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />English | USD</a></li>
                        <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-uk.png" data-label="English | GBP"><img src="/images/misc/flag-uk.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />English | GBP</a></li>
                        <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-de.png" data-label="Deutsch | EUR"><img src="/images/misc/flag-de.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />Deutsch | EUR</a></li>
                        <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-fr.png" data-label="Français | EUR"><img src="/images/misc/flag-fr.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />Français | EUR</a></li>
                        <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-cn.png" data-label="中文 | CNY"><img src="/images/misc/flag-cn.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />中文 | CNY</a></li>
                        <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-ae.png" data-label="العربية | AED"><img src="/images/misc/flag-ae.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />العربية | AED</a></li>
                        <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-ru.png" data-label="Русский | RUB"><img src="/images/misc/flag-ru.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />Русский | RUB</a></li>
                        <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-it.png" data-label="Italiano | EUR"><img src="/images/misc/flag-it.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />Italiano | EUR</a></li>
                    </ul>
                </div>
                <a href="#">Partnership</a>
                <a href="#">Privacy policy</a>
            </div>
        </div>
    </div>
</div>

<!-- MAIN HEADER -->
<header class="main-header">
    <div class="container-xxl">
        <div class="d-flex align-items-center gap-3">
            <!-- Logo -->
            <a asp-controller="Home" asp-action="Index" class="flex-shrink-0">
                    @if (System.IO.File.Exists(System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot/images/logo.png")))
                {
                    <img src="/images/logo.png" class="logo-img" alt="Brand" />
                }
                else
                {
                    <div class="logo-box"><i class="bi bi-shop"></i> Brand</div>
                }
            </a>

            <!-- Search (desktop) -->
            <form asp-controller="Product" asp-action="Index" method="get" class="search-wrap d-none d-lg-flex">
                <div class="input-group">
                    <select name="categoryId" class="search-cat">
                        <option value="">All category</option>
                        @if (ViewBag.AllCategories != null)
                        {
                            foreach (var c in (List<EcommerceApp.Models.Category>)ViewBag.AllCategories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    </select>
                    <input type="text" name="search" class="search-input" placeholder="Search products, brands and categories" value="@ViewBag.SearchQuery" />
                    <button type="submit" class="search-btn"><i class="bi bi-search me-1"></i>Search</button>
                </div>
            </form>

            <!-- Icons -->
            <div class="d-flex gap-3 ms-auto">
                <a asp-controller="Account" asp-action="@(User.Identity!.IsAuthenticated ? "Login" : "Login")" class="hdr-icon">
                    <i class="bi bi-person"></i>
                    <span>Profile</span>
                </a>
                <a href="#" class="hdr-icon d-none d-md-flex">
                    <i class="bi bi-chat-dots"></i>
                    <span>Message</span>
                </a>
                <a href="#" class="hdr-icon d-none d-md-flex">
                    <i class="bi bi-heart"></i>
                    <span>Wishlist</span>
                </a>
                <a asp-controller="Cart" asp-action="Index" class="hdr-icon">
                    <i class="bi bi-cart3"></i>
                    <span class="cart-badge" id="cart-count">0</span>
                    <span>My cart</span>
                </a>
            </div>
        </div>
    </div>
</header>

<!-- NAV BAR -->
<nav class="main-nav d-none d-md-block">
    <div class="container-xxl">
        <div class="nav-inner">
            <div class="dropdown">
                <button class="nav-btn dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="bi bi-grid-3x3-gap-fill"></i> All category
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Index"><i class="bi bi-grid me-2"></i>All Products</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="1"><i class="bi bi-phone me-2"></i>Electronics</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="2"><i class="bi bi-bag me-2"></i>Clothes</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="3"><i class="bi bi-cpu me-2"></i>Gadgets</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="4"><i class="bi bi-backpack me-2"></i>Accessories</a></li>
                    <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-categoryId="5"><i class="bi bi-watch me-2"></i>Smart Watches</a></li>
                </ul>
            </div>
            <a asp-controller="Product" asp-action="Index" asp-route-sortBy="rating">Hot offers</a>
            <a href="#">Gift boxes</a>
            <a href="#">Projects</a>
            <a href="#">Menu item</a>
            <div class="dropdown ms-auto">
                <button class="nav-btn dropdown-toggle">Help <i class="bi bi-chevron-down" style="font-size:10px"></i></button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="#">Help Center</a></li>
                    <li><a class="dropdown-item" href="#">Contact support</a></li>
                    <li><a class="dropdown-item" href="#">FAQ</a></li>
                </ul>
            </div>
        </div>
    </div>
</nav>

<!-- ALERTS -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-0">
        <div class="container-xxl"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-0">
        <div class="container-xxl"><i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    </div>
}

<!-- LOGIN REQUIRED BANNER -->
@if (!User.Identity!.IsAuthenticated)
{
    <div style="background:#fff8e1;border-bottom:1px solid #ffe082;padding:7px 0;font-size:13px;text-align:center">
        <i class="bi bi-info-circle text-warning"></i>
        <a asp-controller="Account" asp-action="Login" class="text-primary fw-semibold ms-1">Sign in</a> or
        <a asp-controller="Account" asp-action="Register" class="text-primary fw-semibold">Register</a>
        to add items to cart and place orders.
    </div>
}

<!-- MAIN CONTENT -->
<main>@RenderBody()</main>

<!-- FOOTER -->
<footer class="main-footer">
    <div class="container-xxl">
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="logo-box mb-3" style="display:inline-flex"><i class="bi bi-shop me-2"></i>Brand</div>
                <p class="footer-desc">Best information about the company goes here but now lorem ipsum is.</p>
                <div class="footer-social mt-3">
                    <a href="#"><i class="bi bi-facebook"></i></a>
                    <a href="#"><i class="bi bi-twitter"></i></a>
                    <a href="#"><i class="bi bi-linkedin"></i></a>
                    <a href="#"><i class="bi bi-instagram"></i></a>
                    <a href="#"><i class="bi bi-youtube"></i></a>
                </div>
            </div>
            <div class="col-lg-2 col-md-6 col-6">
                <div class="footer-head">About</div>
                <ul class="footer-links">
                    <li><a href="#">About Us</a></li>
                    <li><a href="#">Find a store</a></li>
                    <li><a href="#">Rules and Terms</a></li>
                    <li><a href="#">Sitemap</a></li>
                </ul>
            </div>
            <div class="col-lg-2 col-md-6 col-6">
                <div class="footer-head">Partnership</div>
                <ul class="footer-links">
                    <li><a href="#">About Us</a></li>
                    <li><a href="#">Find a store</a></li>
                    <li><a href="#">Categories</a></li>
                    <li><a href="#">Blogs</a></li>
                </ul>
            </div>
            <div class="col-lg-2 col-md-6 col-6">
                <div class="footer-head">Information</div>
                <ul class="footer-links">
                    <li><a href="#">Help Center</a></li>
                    <li><a href="#">Money Refund</a></li>
                    <li><a href="#">Shipping Info</a></li>
                    <li><a href="#">Contact us</a></li>
                </ul>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="footer-head">Get app</div>
                <a href="#" class="app-btn"><i class="bi bi-apple" style="font-size:20px"></i><div><small style="font-size:9px;display:block">Download on the</small><strong>App Store</strong></div></a>
                <a href="#" class="app-btn"><i class="bi bi-google-play" style="font-size:18px"></i><div><small style="font-size:9px;display:block">Get it on</small><strong>Google Play</strong></div></a>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© 2025 Ecommerce. All rights reserved.</span>
            <div class="dropdown">
                <button class="flag-btn dropdown-toggle border-0 bg-transparent" data-bs-toggle="dropdown">
                    <img id="footer-flag" src="/images/misc/flag-us.png" alt="US" onerror="this.style.display='none'" />
                    <span id="footer-lang">English</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" style="min-width:160px;font-size:13px">
                    <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-us.png" data-label="English | USD"><img src="/images/misc/flag-us.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />English | USD</a></li>
                    <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-uk.png" data-label="English | GBP"><img src="/images/misc/flag-uk.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />English | GBP</a></li>
                    <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-de.png" data-label="Deutsch | EUR"><img src="/images/misc/flag-de.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />Deutsch | EUR</a></li>
                    <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-fr.png" data-label="Français | EUR"><img src="/images/misc/flag-fr.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />Français | EUR</a></li>
                    <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-cn.png" data-label="中文 | CNY"><img src="/images/misc/flag-cn.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />中文 | CNY</a></li>
                    <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-ae.png" data-label="العربية | AED"><img src="/images/misc/flag-ae.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />العربية | AED</a></li>
                    <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-ru.png" data-label="Русский | RUB"><img src="/images/misc/flag-ru.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />Русский | RUB</a></li>
                    <li><a class="dropdown-item lang-option" href="#" data-flag="/images/misc/flag-it.png" data-label="Italiano | EUR"><img src="/images/misc/flag-it.png" style="height:14px;margin-right:8px" onerror="this.style.display='none'" />Italiano | EUR</a></li>
                </ul>
            </div>
        </div>
    </div>
</footer>

<!-- MOBILE BOTTOM NAV -->
<nav class="mobile-nav">
    <a asp-controller="Home" asp-action="Index" class="mob-nav-item"><i class="bi bi-house-fill"></i><span>Home</span></a>
    <a asp-controller="Product" asp-action="Index" class="mob-nav-item"><i class="bi bi-grid-fill"></i><span>Browse</span></a>
    <a asp-controller="Cart" asp-action="Index" class="mob-nav-item"><i class="bi bi-cart-fill"></i><span>Cart</span></a>
    <a asp-controller="Account" asp-action="Login" class="mob-nav-item"><i class="bi bi-person-fill"></i><span>Account</span></a>
    <button class="mob-nav-item border-0 bg-transparent" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu"><i class="bi bi-list"></i><span>Menu</span></button>
</nav>

<!-- MOBILE OFFCANVAS MENU -->
<div class="offcanvas offcanvas-start" id="mobileMenu" style="width:280px">
    <div class="offcanvas-header border-bottom">
        <div class="logo-box"><i class="bi bi-shop me-2"></i>Brand</div>
        <button class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0">
        @if (User.Identity!.IsAuthenticated)
        {
            <div class="p-3 bg-light border-bottom">
                <div style="font-size:13px"><i class="bi bi-person-circle me-2"></i>@User.Identity.Name</div>
            </div>
        }
        <div class="list-group list-group-flush">
            <a asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action py-3"><i class="bi bi-house me-2"></i>Home</a>
            <a asp-controller="Product" asp-action="Index" class="list-group-item list-group-item-action py-3"><i class="bi bi-grid me-2"></i>All Products</a>
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="1" class="list-group-item list-group-item-action py-3"><i class="bi bi-phone me-2"></i>Electronics</a>
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="2" class="list-group-item list-group-item-action py-3"><i class="bi bi-bag me-2"></i>Clothes</a>
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="3" class="list-group-item list-group-item-action py-3"><i class="bi bi-cpu me-2"></i>Gadgets</a>
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="4" class="list-group-item list-group-item-action py-3"><i class="bi bi-backpack me-2"></i>Accessories</a>
            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="5" class="list-group-item list-group-item-action py-3"><i class="bi bi-watch me-2"></i>Smart Watches</a>
            <hr class="my-1" />
            <a asp-controller="Order" asp-action="MyOrders" class="list-group-item list-group-item-action py-3"><i class="bi bi-bag-check me-2"></i>My Orders</a>
            @if (!User.Identity!.IsAuthenticated)
            {
                <a asp-controller="Account" asp-action="Login" class="list-group-item list-group-item-action py-3 text-primary"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In</a>
                <a asp-controller="Account" asp-action="Register" class="list-group-item list-group-item-action py-3"><i class="bi bi-person-plus me-2"></i>Register</a>
            }
            else
            {
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="list-group-item list-group-item-action py-3 text-danger border-0 w-100 text-start bg-transparent"><i class="bi bi-box-arrow-left me-2"></i>Logout</button>
                </form>
            }
            <hr class="my-1" />
            <a href="#" class="list-group-item list-group-item-action py-3"><i class="bi bi-globe me-2"></i>English | USD</a>
            <a href="#" class="list-group-item list-group-item-action py-3"><i class="bi bi-headset me-2"></i>Contact us</a>
            <a href="#" class="list-group-item list-group-item-action py-3"><i class="bi bi-shield-check me-2"></i>Privacy policy</a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    fetch('/Cart/GetCartCount').then(r=>r.json()).then(d=>{
        const b=document.getElementById('cart-count');
        if(b) b.textContent=d.count||0;
    }).catch(()=>{});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
