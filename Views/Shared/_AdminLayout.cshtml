<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"/>
    <link rel="stylesheet" href="~/css/site.css"/>
</head>
<body style="background:#f4f6f9">
<div class="admin-wrap">
  <div class="admin-side">
    <div class="brand p-3">
      <div class="logo-box" style="font-size:16px"><i class="bi bi-shop me-2"></i>Brand Admin</div>
    </div>
    <nav class="admin-nav mt-2">
      <a asp-controller="Admin" asp-action="Index" class="@(ViewContext.RouteData.Values["action"]?.ToString()=="Index"?"active":"")"><i class="bi bi-speedometer2"></i> Dashboard</a>
      <a asp-controller="Admin" asp-action="Products" class="@(ViewContext.RouteData.Values["action"]?.ToString() is "Products" or "CreateProduct" or "EditProduct"?"active":"")"><i class="bi bi-box-seam"></i> Products</a>
      <a asp-controller="Admin" asp-action="Categories" class="@(ViewContext.RouteData.Values["action"]?.ToString()=="Categories"?"active":"")"><i class="bi bi-grid"></i> Categories</a>
      <a asp-controller="Admin" asp-action="Orders" class="@(ViewContext.RouteData.Values["action"]?.ToString()=="Orders"?"active":"")"><i class="bi bi-bag-check"></i> Orders</a>
      <hr style="border-color:rgba(255,255,255,.1);margin:8px 16px"/>
      <a asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> View Store</a>
      <form asp-controller="Account" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" style="display:flex;align-items:center;gap:10px;padding:11px 18px;color:rgba(255,255,255,.6);background:none;border:none;cursor:pointer;font-size:13px;width:100%;border-left:3px solid transparent"><i class="bi bi-box-arrow-left"></i> Logout</button>
      </form>
    </nav>
  </div>
  <div class="admin-content">
    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show py-2"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show py-2"><i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @RenderBody()
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
